# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.

# Turso
# Create a database at https://app.turso.tech, then copy its libSQL URL and
# generate a database auth token.
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-database-token

# Better Auth
# Generate a secret with: npx auth@latest secret
# Use the deployed HTTPS origin in production, without a trailing slash.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary
# Copy these values from the API Keys section of the Cloudinary console.
# CLOUDINARY_API_SECRET is server-only and must never use a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
